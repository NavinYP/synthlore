# ==============================================================================
# Azure AI Foundry Configuration
# ==============================================================================
# You can authenticate using EITHER the Project Connection String (recommended for Foundry)
# OR the standard Endpoint + API Key approach.

# Approach A: Unified AI Foundry SDK (Project Connection String)
# PROJECT_CONNECTION_STRING="your_project_connection_string_here"

# Approach B: Standard Azure OpenAI Standalone Keys
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
AZURE_OPENAI_API_KEY="your_api_key_here"

# API Version
API_VERSION="2026-04-01-preview"

# ==============================================================================
# Model Deployments (Match these to your exact deployment names in Azure)
# ==============================================================================
REASONING_DEPLOYMENT_NAME="o3"
BULK_LORE_DEPLOYMENT_NAME="gpt-5.6-luna"
EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-large"
RERANK_DEPLOYMENT_NAME="cohere-rerank-v4.0-pro"
VISION_DEPLOYMENT_NAME="gpt-5.6-sol"
IMAGE_GENERATION_DEPLOYMENT="gpt-image-2"

# ==============================================================================
# Rate Limiting
# ==============================================================================
REQUESTS_PER_MINUTE=100
